
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pink Girls ♡</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --pink: #f45b98;
      --dark-pink: #d94380;
      --light-pink: #ffe4ef;
      --pale-pink: #fff6fa;
      --text: #b94d7b;
      --white: #ffffff;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Quicksand', sans-serif;
      background: var(--pale-pink);
      color: var(--text);
    }

    /* MENU */

    header {
      position: sticky;
      top: 0;
      z-index: 10;
      background: rgba(255, 246, 250, 0.94);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid #ffd1e3;
    }

    nav {
      max-width: 1200px;
      margin: auto;
      padding: 16px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
    }

    .logo {
      font-family: 'Fredoka', sans-serif;
      font-size: 29px;
      font-weight: 600;
      color: var(--pink);
      text-decoration: none;
      white-space: nowrap;
    }

    .links {
      display: flex;
      gap: 24px;
      flex-wrap: wrap;
      justify-content: center;
    }

    .links a {
      color: var(--text);
      text-decoration: none;
      font-weight: 700;
      transition: 0.2s;
    }

    .links a:hover {
      color: var(--pink);
      transform: translateY(-2px);
    }

    .pill {
      background: var(--pink);
      color: white;
      padding: 12px 20px;
      border-radius: 30px;
      text-decoration: none;
      font-weight: 700;
      white-space: nowrap;
      transition: 0.25s;
    }

    .pill:hover, .button:hover {
      background: var(--dark-pink);
      transform: translateY(-3px);
    }

    /* ACCUEIL */

    .hero {
      min-height: 440px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 60px 8%;
      gap: 35px;
      background:
        radial-gradient(circle at 80% 20%, #fff8fc, transparent 30%),
        linear-gradient(135deg, #ffe1ed, #ffc5df);
      overflow: hidden;
    }

    .hero-content {
      max-width: 520px;
      flex: 1;
    }

    .hero h1 {
      font-family: 'Fredoka', sans-serif;
      color: var(--pink);
      font-size: clamp(42px, 5vw, 68px);
      line-height: 1.1;
      margin-bottom: 22px;
    }

    .hero p {
      font-size: 18px;
      line-height: 1.8;
      margin-bottom: 28px;
    }

    .button {
      display: inline-block;
      background: var(--pink);
      color: white;
      padding: 15px 30px;
      border-radius: 35px;
      text-decoration: none;
      font-weight: 700;
      box-shadow: 0 7px 18px #f45b9830;
      transition: 0.25s;
    }

    .hero-art {
      flex: 1;
      max-width: 480px;
      min-height: 260px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: clamp(100px, 16vw, 190px);
      text-align: center;
      filter: drop-shadow(0 12px 15px #e86e9b35);
      animation: float 3s ease-in-out infinite;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-12px); }
    }

    /* PETITES RUBRIQUES */

    .features {
      max-width: 1150px;
      margin: auto;
      padding: 45px 24px 25px;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 22px;
    }

    .feature {
      text-align: center;
      padding: 18px 12px;
      border-radius: 22px;
      transition: 0.25s;
    }

    .feature:hover {
      background: white;
      transform: translateY(-5px);
      box-shadow: 0 10px 30px #ed91b51a;
    }

    .feature-icon {
      width: 58px;
      height: 58px;
      display: grid;
      place-items: center;
      margin: 0 auto 14px;
      background: var(--light-pink);
      border-radius: 50%;
      font-size: 28px;
    }

    .feature h3 {
      font-family: 'Fredoka', sans-serif;
      font-size: 21px;
      margin-bottom: 9px;
      color: var(--pink);
    }

    .feature p {
      line-height: 1.6;
      font-size: 15px;
    }

    /* GALERIE */

    .gallery {
      max-width: 1150px;
      margin: auto;
      padding: 30px 24px 55px;
      text-align: center;
    }

    .section-title {
      font-family: 'Fredoka', sans-serif;
      font-size: clamp(28px, 4vw, 38px);
      color: var(--pink);
      margin-bottom: 30px;
    }

    .photos {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 22px;
    }

    .photo-card {
      background: white;
      border: 1px solid #ffe1ed;
      border-radius: 20px;
      overflow: hidden;
      transition: 0.3s;
    }

    .photo-card:hover {
      transform: translateY(-7px) rotate(-1deg);
      box-shadow: 0 12px 28px #e77ca42b;
    }

    .photo-card img {
      display: block;
      width: 100%;
      height: 180px;
      object-fit: cover;
      background: var(--light-pink);
    }

    .photo-card p {
      padding: 17px 10px;
      font-weight: 700;
    }

    /* PETIT MOT */

    .quote {
      text-align: center;
      padding: 48px 20px;
      background: #ffe4ef;
    }

    .quote h2 {
      font-family: 'Fredoka', sans-serif;
      font-size: 30px;
      color: var(--pink);
      margin-bottom: 12px;
    }

    .quote p {
      line-height: 1.8;
    }

    /* PIED DE PAGE */

    footer {
      padding: 28px 20px;
      text-align: center;
      background: #ffd5e6;
      line-height: 2;
    }

    footer strong {
      font-family: 'Fredoka', sans-serif;
      font-size: 23px;
      color: var(--pink);
    }

    .socials a {
      color: var(--dark-pink);
      text-decoration: none;
      margin: 0 9px;
      font-weight: 700;
    }

    /* TELEPHONE */

    @media (max-width: 800px) {
      nav {
        flex-direction: column;
      }

      .links {
        gap: 15px;
      }

      .hero {
        flex-direction: column;
        text-align: center;
        padding: 55px 24px 35px;
      }

      .hero-art {
        min-height: 180px;
      }

      .features {
        grid-template-columns: repeat(2, 1fr);
      }

      .photos {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 430px) {
      .logo {
        font-size: 26px;
      }

      .links {
        gap: 12px;
        font-size: 14px;
      }

      .pill {
        padding: 10px 16px;
      }

      .features {
        gap: 8px;
        padding-left: 12px;
        padding-right: 12px;
      }

      .photos {
        gap: 12px;
      }

      .photo-card img {
        height: 135px;
      }
    }
  </style>
</head>

<body>

  <header>
    <nav>
      <a href="#accueil" class="logo">🎀 Pink Girls ♡</a>

      <div class="links">
        <a href="#accueil">♡ Accueil</a>
        <a href="#apropos">🌸 À propos</a>
        <a href="#galerie">♡ Galerie</a>
        <a href="#conseils">♡ Conseils</a>
        <a href="#contact">♡ Contact</a>
      </div>

      <a href="#galerie" class="pill">♥ Rêve en rose ♡</a>
    </nav>
  </header>

  <main>
    <section class="hero" id="accueil">
      <div class="hero-content">
        <h1>Bienvenue sur Pink Girls ♡</h1>
        <p>
          Un petit espace tout doux pour les filles qui aiment
          les jolies choses, la bonne humeur et les rêves en rose !
          🌷✨
        </p>
        <a href="#apropos" class="button">Découvrir ♡</a>
      </div>

      <div class="hero-art" aria-label="Univers kawaii">
        🎀🐱💕
      </div>
    </section>

    <section class="features" id="apropos">
      <article class="feature">
        <div class="feature-icon">♡</div>
        <h3>Mode & Style</h3>
        <p>Des idées pour un look 100% girly ! 🎀</p>
      </article>

      <article class="feature">
        <div class="feature-icon">✩</div>
        <h3>Beauté & Bien-être</h3>
        <p>Prends soin de toi, tu le mérites ! 🌸</p>
      </article>

      <article class="feature">
        <div class="feature-icon">🎀</div>
        <h3>Inspiration</h3>
        <p>Des petites citations qui font du bien. 💗</p>
      </article>

      <article class="feature">
        <div class="feature-icon">♡</div>
        <h3>Communauté</h3>
        <p>Un univers de filles trop chou ! 🧸</p>
      </article>
    </section>

    <section class="gallery" id="galerie">
      <h2 class="section-title">♡ Nos coups de cœur ♡</h2>

      <div class="photos">
        <article class="photo-card">
          <img
            src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=600&q=80"
            alt="Inspiration mode"
            loading="lazy">
          <p>Les petites choses qui font le bonheur ♡</p>
        </article>

        <article class="photo-card">
          <img
            src="https://images.unsplash.com/photo-1490730141103-6cac27aaab94?auto=format&fit=crop&w=600&q=80"
            alt="Ciel rose et coucher de soleil"
            loading="lazy">
          <p>Des rêves plein la tête ♡</p>
        </article>

        <article class="photo-card">
          <img
            src="https://images.unsplash.com/photo-1601049541289-9b1b7bbbfe19?auto=format&fit=crop&w=600&q=80"
            alt="Beauté et soins"
            loading="lazy">
          <p>Prendre soin de soi ♡</p>
        </article>

        <article class="photo-card">
          <img
            src="https://images.unsplash.com/photo-1490750967868-88aa4486c946?auto=format&fit=crop&w=600&q=80"
            alt="Jolies fleurs"
            loading="lazy">
          <p>La vie en rose ♡</p>
        </article>
      </div>
    </section>

    <section class="quote" id="conseils">
      <h2>Un petit rappel pour toi 💗</h2>
      <p>
        Tu es unique, tu es précieuse et tu mérites de briller. ✨<br>
        Sois toi-même, rêve grand et garde ton joli sourire ! 🎀
      </p>
    </section>
  </main>

  <footer id="contact">
    <strong>🎀 Pink Girls ♡</strong>
    <p>♥ Parce que chaque fille est unique ♥</p>

    <div class="socials">
      <a href="https://www.instagram.com/" target="_blank"
         rel="noopener noreferrer">Instagram ♡</a>
      <a href="https://www.pinterest.com/" target="_blank"
         rel="noopener noreferrer">Pinterest ♡</a>
    </div>

    <p>Fait avec amour 💕 © 2026 Pink Girls</p>
  </footer>

</body>
</html>
